# SkillBridge Platform - Root Environment Variables Template
# Copy this file to .env and populate with your production credentials

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://skillbridge-platform.vercel.app

# MySQL Database Configuration
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_secure_db_password
DB_NAME=skillbridge_db
DB_SSL=true

# Alternative: Single Connection URI (e.g. Railway, TiDB, Aiven, Render)
# DATABASE_URL=mysql://username:password@host:3306/skillbridge_db?sslaccept=strict

# Security & Sessions
JWT_SECRET=your_jwt_secret_change_in_production
