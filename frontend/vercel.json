{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/role-selection.html" },
    { "source": "/role-selection", "destination": "/role-selection.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/student-dashboard", "destination": "/student-dashboard.html" },
    { "source": "/company-login", "destination": "/company-login.html" },
    { "source": "/company-register", "destination": "/company-register.html" },
    { "source": "/recruiter-home", "destination": "/recruiter-home.html" },
    { "source": "/recruiter-dashboard", "destination": "/recruiter-dashboard.html" },
    { "source": "/internships", "destination": "/internships.html" },
    { "source": "/skill-assessment", "destination": "/skill-assessment.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
