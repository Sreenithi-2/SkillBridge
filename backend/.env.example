# ==============================================================================
# SkillBridge Backend Environment Configuration Template
# Copy this file to '.env' and fill in your local MySQL credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=skillbridge_db

# CORS Allowed Client Origin (Frontend preview server)
CLIENT_URL=http://localhost:3000
